# Path to the cloned uptime-service-backend repo (used as docker build context).
# Default assumes sibling layout: o1labs/uptime-service-backend/ next to this repo.
# NOTE: the backend must include the S3OptionsFromEnv patch — until merged to
# main, check out the feat/s3-force-path-style branch in this clone.
# Resolved relative to compose/ (the docker-compose.yaml location), so use ../../ from repo root.
BACKEND_REPO_PATH=../../uptime-service-backend

# Bucket created in MinIO. Must match GetAWSBucketName(): <account_id>-<bucket_name_suffix>
# from compose/config/backend.json.
E2E_BUCKET=test-uptime

# Host port bindings (kept off the standard ports to avoid clashes with local services).
POSTGRES_HOST_PORT=55432
MINIO_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001
BACKEND_HOST_PORT=8080
