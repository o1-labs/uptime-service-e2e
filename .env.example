# Pinned image tag for the backend under test. Pin to a release tag (e.g.
# v2.0.5) for reproducible runs; bump intentionally when validating a new
# backend release. Avoid `latest` — it makes test results non-reproducible.
BACKEND_TAG=v2.0.5
VALIDATION_TAG=v2.0.10
WORKER_TAG=main-97163be

# Bucket created in MinIO. Must match GetAWSBucketName(): <account_id>-<bucket_name_suffix>
# from compose/config/backend.json.
E2E_BUCKET=test-uptime

# Host port bindings (kept off the standard ports to avoid clashes with local services).
POSTGRES_HOST_PORT=55432
MINIO_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001
BACKEND_HOST_PORT=8080
