# Pinned image tags for the components under test. Pin to release tags
# (e.g. v2.0.5) for reproducible runs; bump intentionally when validating
# a new release. Avoid `latest` — it makes test results non-reproducible.
BACKEND_TAG=v2.0.5
VALIDATION_TAG=v2.0.10
# Underlying base for the locally-built worker image (compose/worker/Dockerfile).
SUBMISSION_UPDATER_TAG=main-97163be
# Leaderboard's repository name is double-prefixed because the upstream
# helm chart names it that way; the production helmfile uses the same.
LEADERBOARD_API_TAG=main-main-49ac4a8

# Locally-built worker image (see Makefile worker-image target). Leave as
# defaults unless you have a reason to override.
WORKER_IMAGE=uptime-e2e-worker
WORKER_TAG=dev

# Bucket created in MinIO. Must match GetAWSBucketName(): <account_id>-<bucket_name_suffix>
# from compose/config/backend.json.
E2E_BUCKET=test-uptime

# Host port bindings (kept off the standard ports to avoid clashes with local services).
POSTGRES_HOST_PORT=55432
MINIO_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001
BACKEND_HOST_PORT=8080
LEADERBOARD_API_HOST_PORT=55000
